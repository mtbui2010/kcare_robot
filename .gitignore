# Python bytecode / build artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# Backup copies: use git history instead of *.bak / *.orig files
*.bak
*.orig
*.rej
*.before_cleanup_*
*.pre-[0-9]*

# Runtime output (rule: configs/ holds configuration only). robot_agent
# writes these under configs/common/: task_runs/<host>/ and grace_memory.<host>.jsonl
# (core/planning/loop.py), object_memory.<host>.json (assist_loop.py),
# world_state.<host>.json (state.py), logs/<host>/ (state.py, when no log_dir).
# The 69 legacy runs and world_state.json already tracked stay in git on
# purpose; see docs/notes/runtime_data.md.
kcare_robot/configs/common/task_runs/
kcare_robot/configs/common/run_records/
kcare_robot/configs/common/grace_memory.*.jsonl
kcare_robot/configs/common/object_memory.*.json
kcare_robot/configs/common/world_state.*.json
kcare_robot/configs/common/logs/
kcare_robot/data/logs/
# the removed Planner Guide store (robot_agent builds the direct planner's prompt; an old file is never read)
kcare_robot/configs/common/guides.json
